       IDENTIFICATION DIVISION.
       PROGRAM-ID. PTHSENS.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-PGM PIC X(8).
       01 WS-COPY PIC X(8).
       01 WS-SINGLE PIC X(8).
       01 WS-KILLED PIC X(8).
       01 WS-AFTER-KILL PIC X(8).
       01 WS-CICS-PGM PIC X(8).
       01 WS-CICS-KILLED PIC X(8).
       01 WS-QUEUE PIC X(9).
       01 WS-QUEUE-KILLED PIC X(8).
       01 WS-LONG-PGM PIC X(8).
       01 WS-LONG-COPY PIC X(8).
       01 WS-RESP PIC X(8).
       01 WS-AREA PIC X(20).
       PROCEDURE DIVISION.
       MAIN-PARA.
           MOVE "PROG-A" TO WS-PGM
           CALL WS-PGM
           CALL "STATPROG"
           MOVE "PROG-B" TO WS-PGM
           CALL WS-PGM
           MOVE WS-PGM TO WS-COPY
           MOVE 'PROG-C' TO WS-SINGLE
           MOVE "PROG-D" TO WS-KILLED
           ACCEPT WS-KILLED
           CALL WS-KILLED
           MOVE WS-KILLED TO WS-AFTER-KILL
           MOVE "CICSA" TO WS-CICS-PGM
           EXEC CICS LINK PROGRAM(WS-CICS-PGM)
                COMMAREA(WS-COPY)
           END-EXEC
           MOVE "CICSB" TO WS-CICS-PGM
           EXEC CICS LINK PROGRAM(WS-CICS-PGM)
                COMMAREA(WS-COPY)
           END-EXEC
           MOVE "CICSKILL" TO WS-CICS-KILLED
           ACCEPT WS-CICS-KILLED
           EXEC CICS LINK PROGRAM(WS-CICS-KILLED)
                COMMAREA(WS-COPY)
           END-EXEC
           EXEC CICS LINK PROGRAM('LITPGM')
                COMMAREA(WS-COPY)
           END-EXEC
           MOVE "CUSTOMERQ" TO WS-QUEUE
           EXEC CICS READQ TS QUEUE(WS-QUEUE)
                INTO(WS-AREA)
           END-EXEC
           MOVE "KILLQ" TO WS-QUEUE-KILLED
           ACCEPT WS-QUEUE-KILLED
           EXEC CICS READQ TS QUEUE(WS-QUEUE-KILLED)
                INTO(WS-AREA)
           END-EXEC
           EXEC CICS RECEIVE INTO(WS-AREA) END-EXEC
           MOVE "LONGERTHAN8" TO WS-LONG-PGM
           CALL WS-LONG-PGM
           MOVE WS-LONG-PGM TO WS-LONG-COPY
           MOVE "CICSRSP" TO WS-CICS-PGM
           MOVE "RESPVAL" TO WS-RESP
           EXEC CICS LINK PROGRAM(WS-CICS-PGM)
                RESP(WS-RESP)
           END-EXEC
           GOBACK.
